# ════════════════════════════════════════════════════════════════
#  ZKAuction — Environment Variables
#  Copy this file: cp .env.example .env.local
#  NEVER commit .env.local to git!
# ════════════════════════════════════════════════════════════════

# ─── Midnight Network Selection ───────────────────────────────
# Options: "TestNet" (Preprod) | "DevNet" (local docker stack)
NEXT_PUBLIC_MIDNIGHT_NETWORK=TestNet

# ─── Midnight Preprod Endpoints ───────────────────────────────
# Use these when MIDNIGHT_NETWORK=TestNet
# These are the public Midnight Preprod endpoints

# Midnight blockchain node (WebSocket RPC)
NEXT_PUBLIC_NODE_WS_URL=wss://rpc.testnet-01.midnight.network/ws

# Midnight indexer (GraphQL — used to watch contract state)
NEXT_PUBLIC_INDEXER_URI=https://indexer.testnet-01.midnight.network/api/v1/graphql
NEXT_PUBLIC_INDEXER_WS_URI=wss://indexer.testnet-01.midnight.network/api/v1/graphql

# Midnight Proof Server URL
# For Preprod: use the public proof server
# For local dev: use http://localhost:6300 (docker compose up proof-server)
NEXT_PUBLIC_PROOF_SERVER_URI=https://proving.testnet-01.midnight.network

# ─── Local DevNet Endpoints (for local docker compose) ────────
# Uncomment these and set MIDNIGHT_NETWORK=DevNet to use local stack
# NEXT_PUBLIC_NODE_WS_URL=ws://localhost:9944
# NEXT_PUBLIC_INDEXER_URI=http://localhost:8088/api/v1/graphql
# NEXT_PUBLIC_INDEXER_WS_URI=ws://localhost:8088/api/v1/graphql
# NEXT_PUBLIC_PROOF_SERVER_URI=http://localhost:6300

# ─── 1AM Wallet Config ────────────────────────────────────────
# The 1AM wallet injects itself into the browser window.
# No API key needed — it's accessed via window.midnight.mnLace
# or the 1AM wallet connector API.

# ─── Contract Deployment (filled after Phase 6) ───────────────
# After you deploy to Preprod, paste the contract address here
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ─── Vercel Deployment ────────────────────────────────────────
# Set in Vercel project settings → Environment Variables
# Do not put secrets here, they go directly in Vercel dashboard
