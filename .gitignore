# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Midnight-specific ────────────────────────────────────────────
# Compact compiler output (auto-generated, do not commit)
contract/src/generated/index.cjs
contract/src/generated/index.d.ts
contract/src/generated/*.zkir
contract/src/generated/*.mjs

# Private state database (local only, contains private keys)
midnight-private-state.db
*.leveldb/

# Docker volume data
.docker-data/
