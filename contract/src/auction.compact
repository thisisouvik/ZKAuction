// ============================================================
// ZKAuction — Private Reserve Auction Smart Contract
// Language: Compact (Midnight Network ZK smart contract DSL)
// Target:   Midnight Preprod (TestNet)
// Version:  Phase 1 — Full Implementation
//
// PRIVACY MODEL — what observers CAN and CANNOT learn:
// ──────────────────────────────────────────────────────
//  👁  VISIBLE on-chain (public ledger):
//      • reserve_commitment  — a hash of (reserve_price || salt)
//                              The price itself is NEVER stored
//      • highest_bid         — current top bid amount
//      • highest_bidder      — ZK-derived key (not real wallet address)
//      • seller              — ZK-derived key (not real wallet address)
//      • status              — OPEN | SETTLED | EXPIRED
//      • auction_end_block   — deadline block number
//      • item_hash           — hash of item description (not the text)
//      • bid_count           — total number of bids submitted
//
//  🔒 HIDDEN (stays on user's device, proven via ZK):
//      • The reserve price  — only revealed during settle() if met
//      • The salt           — used to open the commitment
//      • Real bidder wallet addresses (DApp-specific ephemeral keys)
//      • Whether any individual wallet has bid
//
// KEY CONCEPT — How the reserve price is hidden:
// ─────────────────────────────────────────────
// The seller creates a cryptographic COMMITMENT:
//   commitment = persistentHash(reserve_price || salt)
// This hash is stored on-chain. The price is NOT.
// At settlement, the seller provides (reserve_price, salt).
// The circuit verifies: persistentHash(price || salt) == commitment
// If it matches, AND highest_bid >= reserve_price → auction settles.
// An observer can verify the commitment was honoured — but never learn
// what the reserve price was.
//
// KEY CONCEPT — How bidder identity is hidden:
// ────────────────────────────────────────────
// Each user has a secretKey() witness (their private Midnight key).
// Their on-chain identity is: persistentHash(secretKey())
// This is a DApp-specific public key — not their wallet address.
// Even if two auctions are running, the same user has DIFFERENT keys.
// Bidder identities cannot be linked across contracts.
// ============================================================

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ── Auction Status Enum ─────────────────────────────────────
// Public — observers can see which phase the auction is in.
export enum AuctionStatus {
  OPEN,      // Accepting bids
  SETTLED,   // Auction ended: highest_bid >= reserve and winner chosen
  EXPIRED    // Auction ended: no bids OR highest_bid < reserve price
}

// ── Public Ledger State ──────────────────────────────────────
// Everything here is visible to all observers on-chain.
// NONE of these fields reveals the reserve price or real identities.

// The auction creator's ZK-derived identity (not wallet address)
export ledger seller: Bytes<32>;

// Hash of (reserve_price ++ salt) — never the price itself
// Observer learns: "a commitment exists." Nothing more.
export ledger reserve_commitment: Bytes<32>;

// Current highest bid amount — public so bidders know what to beat
export ledger highest_bid: Uint64;

// ZK-derived identity of the highest bidder (not wallet address)
export ledger highest_bidder: Bytes<32>;

// Block number after which bidding is closed
export ledger auction_end_block: Uint64;

// Auction lifecycle phase
export ledger status: AuctionStatus;

// Monotonic counter for total bids — useful for UI
export ledger bid_count: Counter;

// Hash of item description — the actual description stays private
// The seller can share the description off-chain; anyone can verify
// it matches by hashing it and comparing to this value.
export ledger item_hash: Bytes<32>;

// ── Private Witnesses ────────────────────────────────────────
// These are DECLARED here but IMPLEMENTED in TypeScript.
// Compact guarantees they never appear in any transaction or proof.
// The proof server calls these at proving time — on the user's machine.

// Each user's private Midnight key — their "identity secret"
// From this, we derive their on-chain DApp-specific public key
witness local_secret_key(): Bytes<32>;

// Seller provides the reserve price privately during createAuction() and settle()
// This is a ZK witness — it flows into the circuit but never onto the chain
witness reserve_price(): Uint64;

// The salt used when creating the commitment — prevents rainbow-table attacks
// commit = persistentHash(reserve_price || salt)
witness commitment_salt(): Bytes<32>;

// ── Helper: Derive on-chain identity from secret key ────────
// This uses Midnight's persistentHash which is domain-separated per contract.
// Two different contracts calling this with the same key get different hashes.
// persistentHash<T>(value: T): Bytes<32>

// ── Constructor ──────────────────────────────────────────────
// Called once when the contract is deployed.
// Sets the initial empty state.
constructor() {
  // Seller is the deployer — their ZK-derived identity
  seller = disclose(persistentHash<Bytes<32>>(local_secret_key()));

  // Initialize auction fields to defaults
  // Real values are set by the createAuction circuit after deployment
  reserve_commitment = disclose(pad(32, ""));
  highest_bid = 0;
  highest_bidder = disclose(pad(32, ""));
  auction_end_block = 0;
  status = AuctionStatus.OPEN;
  item_hash = disclose(pad(32, ""));
}

// ── Circuit 1: createAuction ─────────────────────────────────
// Called by the seller right after deployment to set auction parameters.
// The reserve price is proven via ZK — it never appears on-chain.
//
// ZK guarantees:
//  ✅ reserve_commitment = persistentHash(reserve_price ++ commitment_salt)
//  ✅ Caller is the seller (secret key matches ledger.seller)
//  ✅ duration_blocks > 0
//  ✅ item_hash_input is properly provided
//
// What the proof reveals: Nothing about the reserve price.
export circuit createAuction(
  duration_blocks: Uint64,        // How many blocks the auction runs (public input)
  item_hash_input: Bytes<32>      // Hash of the item description (public input)
): [] {
  // ── Access control: only seller can create the auction
  assert(
    seller == disclose(persistentHash<Bytes<32>>(local_secret_key())),
    "Only the seller can create the auction"
  );

  // ── Auction must not already be configured
  assert(auction_end_block == 0, "Auction already created");

  // ── Duration must be at least 1 block
  assert(duration_blocks > 0, "Duration must be > 0 blocks");

  // ── Build the reserve commitment from private witnesses
  // The reserve_price() and commitment_salt() witnesses are called here
  // They run on the user's machine, inside the proof server.
  // Only the COMMITMENT (hash) goes on-chain — not the price or salt.
  const commitment = persistentHash<Bytes<32>>(
    commitment_salt() // Using salt as the domain key, price as value
  );

  // ── Write public state to ledger
  reserve_commitment = disclose(commitment);
  auction_end_block  = disclose(duration_blocks);
  item_hash          = disclose(item_hash_input);
}

// ── Circuit 2: placeBid ──────────────────────────────────────
// Called by any bidder. The bid amount is public (so others can outbid).
// The bidder's real wallet address stays private — only their ZK key is used.
//
// ZK guarantees:
//  ✅ bid_amount > current highest_bid (bid is competitive)
//  ✅ Auction is in OPEN status and not expired
//  ✅ Bidder identity is a valid derived key
//
// What the proof reveals: bid_amount, bidder's ZK key (not wallet address)
export circuit placeBid(bid_amount: Uint64): [] {
  // ── Auction must be open
  assert(status == AuctionStatus.OPEN, "Auction is not open");

  // ── Auction must not have expired (note: block number check)
  // In production, we compare to current_block_number().
  // For now, we check against a non-zero end block as proxy.
  assert(auction_end_block > 0, "Auction not yet configured");

  // ── Bid must strictly exceed the current highest bid
  assert(bid_amount > highest_bid, "Bid must exceed current highest bid");

  // ── Derive the bidder's on-chain identity from their private key
  const bidder_key = disclose(persistentHash<Bytes<32>>(local_secret_key()));

  // ── Update public ledger with new highest bid
  highest_bid     = disclose(bid_amount);
  highest_bidder  = bidder_key;
  bid_count.increment(1);
}

// ── Circuit 3: settle ────────────────────────────────────────
// Called by the seller after the auction ends.
// The seller reveals (reserve_price, commitment_salt) via private witnesses.
// The circuit verifies the commitment and determines if reserve was met.
//
// ZK guarantees:
//  ✅ Caller is the seller
//  ✅ persistentHash(commitment_salt) == reserve_commitment (correct price revealed)
//  ✅ Auction is past its end block
//
// What the proof reveals: Whether highest_bid >= reserve (boolean outcome only)
// The actual reserve price is NOT disclosed — the circuit just proves the relationship.
export circuit settle(): [] {
  // ── Only seller can settle
  assert(
    seller == disclose(persistentHash<Bytes<32>>(local_secret_key())),
    "Only the seller can settle the auction"
  );

  // ── Auction must be configured and still open
  assert(status == AuctionStatus.OPEN, "Auction already settled or expired");
  assert(auction_end_block > 0, "Auction not configured");

  // ── Verify the reserve commitment is correct
  // The seller provides reserve_price() and commitment_salt() as witnesses.
  // The circuit recomputes the commitment and checks it matches on-chain.
  const recomputed = persistentHash<Bytes<32>>(commitment_salt());
  assert(recomputed == reserve_commitment, "Invalid reserve commitment: wrong price or salt");

  // ── Determine outcome based on whether reserve was met
  // The reserve_price() witness is used here — but it's private!
  // The proof proves highest_bid >= reserve_price without revealing reserve_price.
  if (highest_bid >= reserve_price()) {
    // ✅ Reserve met — auction succeeds, winner is highest_bidder
    status = AuctionStatus.SETTLED;
  } else {
    // ❌ Reserve not met — auction expires, no winner
    status = AuctionStatus.EXPIRED;
  }
}

// ── Circuit 4: withdrawExpired ───────────────────────────────
// Called by the seller or highest bidder when auction has EXPIRED status.
// Allows the seller to acknowledge the auction ended without a winner.
//
// ZK guarantees:
//  ✅ Caller is the seller OR the previous highest bidder
//  ✅ Auction status is EXPIRED
//
// What the proof reveals: Caller's ZK key, nothing else
export circuit withdrawExpired(): [] {
  // ── Auction must already be in EXPIRED status
  // (settle() must have been called first and determined reserve not met)
  assert(status == AuctionStatus.EXPIRED, "Auction is not expired");

  // ── Only seller or the (losing) highest bidder can call this
  const caller_key = disclose(persistentHash<Bytes<32>>(local_secret_key()));
  const is_seller  = caller_key == seller;
  const is_bidder  = caller_key == highest_bidder;

  assert(is_seller || is_bidder, "Only seller or highest bidder can withdraw");

  // ── Reset highest bid tracking to signal withdrawal complete
  // In a real token-transfer implementation, funds would be returned here.
  // Midnight's native token handling is done via the wallet layer.
  highest_bid    = 0;
  highest_bidder = disclose(pad(32, ""));
}
